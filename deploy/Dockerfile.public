# Official Certbot 5.8.0 includes IP + webroot support. Runtime capability checks
# still reject missing IP/profile/plugin support before contacting the ACME CA.
FROM golang:1.27.3-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
ARG GOPROXY=https://proxy.golang.org,direct
RUN go mod download
COPY internal/acmeip ./internal/acmeip
COPY cmd/relay-public-edge ./cmd/relay-public-edge
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/relay-public-edge ./cmd/relay-public-edge \
 && CGO_ENABLED=0 go test -c -o /out/acmeip.test ./internal/acmeip

FROM certbot/certbot:v5.9.0@sha256:bc93cb710b413e6b456d622f9b0133b3e109c0a78c2ed9976af43d209b0a1805 AS runtime
COPY deploy/requirements-public-security.txt /tmp/requirements-public-security.txt
RUN apk upgrade --no-cache \
 && apk add --no-cache nginx ca-certificates \
 && uv pip install --system --no-cache --no-deps --require-hashes -r /tmp/requirements-public-security.txt \
 # Certbot's fixed webroot runtime does not need pip. Its bundled vendor copies
 # remain vulnerable even after upgrading the separately installed packages.
 && uv pip uninstall --system pip \
 && uv pip check --system \
 && mkdir -p /webroot /state \
 && chmod 755 /webroot && chmod 700 /state
COPY --from=builder /out/relay-public-edge /usr/local/bin/relay-public-edge
STOPSIGNAL SIGTERM

# CI runs actual Nginx + local test CA here; no public CA or host credentials.
FROM runtime AS test
COPY --from=builder /out/acmeip.test /usr/local/bin/acmeip.test
ENV RELAY_PUBLIC_NGINX_TEST=1
ENTRYPOINT ["/usr/local/bin/acmeip.test"]

FROM runtime AS production
ENTRYPOINT ["/usr/local/bin/relay-public-edge"]
