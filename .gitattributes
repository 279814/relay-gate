# 默认按文本处理，行尾交给各平台
* text=auto

# 内置探活模板（P0-06）。这些是 embed 进二进制的数据文件，而 body_text 的
# 内容会**逐字节**成为发出去的请求体。行尾按平台变化的话，同一份模板在
# Windows 检出与 Linux 检出上会产生不同的字节 —— 而 `* text=auto` 恰恰
# 允许那种变化。
internal/probe/builtin/**/*.json text eol=lf
internal/probe/builtin/*.json    text eol=lf

# 这些必须是 LF：目标运行环境是 Linux + Docker，
# CRLF 会让 shell 直接报 "bash: \r: command not found"
*.sh   text eol=lf
*.py   text eol=lf
*.tsv  text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf
*.go   text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# 部署模板固定 LF，避免复制 .env.example 或跨平台执行时引入行尾差异。
# 当前安装为 HTTP IP:port，Compose 使用 .env 做插值；主密钥读取会 TrimSpace。
compose.yaml    text eol=lf
.env.example    text eol=lf
Caddyfile       text eol=lf

# 前端资源（M5）。go:embed 本身不在意行尾，但 alpine.min.js 是**第三方
# 原样收录**的文件 —— CRLF 转换会改变它的字节与哈希，想核对「打进二进制的
# 是不是官方发布的那个」时就对不上了。同目录的其余文件一并统一，
# 免得 diff 里混着两种行尾。
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# PowerShell 脚本保留 CRLF；Windows 和 Linux 的 pwsh 都支持该行尾。
*.ps1  text eol=crlf

# SQLite 库与二进制产物不做行尾转换
*.db   binary
*.png  binary
*.ico  binary

# 协议响应夹具是逐字节 wire 输入；即使内容可读，也禁止 CRLF 归一化。
internal/probe/testdata/responses/*.bin binary
