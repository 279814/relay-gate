# relay-gate 环境变量模板。
#
#   cp .env.example .env   # 可选；不设三项凭据时首次启动会自动生成并打印一次
#
# .env 已在 .gitignore 里。不要把填好的真实凭据提交进仓库。

# ── 可选三项凭据（留空 = 首次启动自动生成并打印一次）────────
#
# 若任一项已由环境变量提供，则不会走自动 bootstrap（环境变量优先）。
# 生成后的值落在 data/secrets/（不进 git）；重启不会再次打印。

# 上游 api_key 的加密密钥（AES-GCM），至少 16 字符。
# **丢失后已存的上游 key 全部无法解密**。
# ENCRYPTION_KEY=

# 发给客户端的 relay key（多个用逗号分隔）。不是上游站的 key。
# RELAY_KEYS=

# 管理界面登录口令，至少 8 字符。
# ADMIN_PASSWORD=

# ── 基础设施（可选）──────────────────────────────────

# 宿主机映射端口（compose 发布到所有接口）。
RELAY_PORT=18787

# 时区。影响探活成本「按天」分桶。
TZ=Asia/Shanghai

# 镜像与 /healthz 上的版本标签。
VERSION=dev
