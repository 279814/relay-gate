# relay-gate 环境变量模板（M7）。
#
#   cp .env.example .env   然后把下面三个必填项填上
#
# .env 已在 .gitignore 里。**不要**把填好的这份提交进仓库 ——
# 它含上游 key 的解密密钥与管理口令。

# ── 必填三项（缺任何一项都拒绝启动，见 config.validate）────────

# 上游 api_key 的加密密钥（AES-GCM），至少 16 字符。
#
# **丢失后已存的上游 key 全部无法解密**，只能一个个重填。
# 生成：openssl rand -hex 32
# 换这个值等同于清空所有上游 key —— 不要为了「轮换」随手改它。
ENCRYPTION_KEY=

# 本服务发给客户端的 key，多个用逗号分隔。ccswitch / Claude Code 填这个，
# **不是**上游站的 key。
#
# 留空等于把你所有上游 key 免费公开给任何能访问到这个端口的人（§5.2f）。
# 习惯上带 rk- 前缀，便于与上游 key 一眼区分。
# 生成：echo "rk-$(openssl rand -hex 24)"
RELAY_KEYS=

# 管理界面登录口令，至少 8 字符。
# 生成：openssl rand -base64 24
ADMIN_PASSWORD=

# ── 可选 ──────────────────────────────────────────────

# 宿主机上映射的端口。只绑 127.0.0.1，改这个不会把它暴露到公网。
RELAY_PORT=18787

# 时区。影响探活成本的「按天」分桶（§5.2d）——
# 不设的话容器只认 UTC，「今日」会在东八区的早上 8 点才清零。
TZ=Asia/Shanghai

# 镜像与容器的版本标签，会出现在启动日志与 /healthz 里。
# 部署后第一个要回答的往往是「我到底推上去了没有」。
VERSION=dev

# ── 仅公网模式（--profile public）需要 ────────────────────

# 你的域名。Caddy 用它自动申请 Let's Encrypt 证书，
# 所以这个域名的 A 记录必须已经指向本机、且 80/443 可从公网访问。
RELAY_DOMAIN=

# 证书到期提醒邮箱。留空也能签发，但到期前收不到任何通知,
# 而证书过期的表现是客户端全面报错。
RELAY_ACME_EMAIL=

# 管理界面的 IP 白名单，空格分隔，支持 CIDR。
#
# **留空 = 管理界面全部 403**（Caddyfile 里是这么写的，刻意的）：
# 忘了配的后果应该是「我进不去」，而不是「全世界都能进」。
# 转发端点不受这个限制，它靠 RELAY_KEYS 鉴权。
#
# 例：RELAY_ALLOW_IPS=203.0.113.4 198.51.100.0/24
RELAY_ALLOW_IPS=
