# M0 探测输入：含真实 key，绝不入库
scripts/upstreams.tsv
scripts/*.local.*

# P0 探活夹具的本机抓包与私有报告。
.local/p0/

# M0 输出：含站点地址
docs/02-上游能力矩阵.md

# 运行时数据
data/
*.db
*.db-shm
*.db-wal

# 构建产物。必须用 / 锚定到根目录：
# 无斜杠的 "relay-gate" 会匹配任意层级的同名目录，
# 把源码目录 cmd/relay-gate/ 一并忽略掉。
/relay-gate
/relay-gate.exe
/dist/

# 环境
.env
.env.local

# 冒烟脚本的运行产物（网关与 mock 靶站的 stdout/stderr）。
# 每跑一次就重新生成一批，不挡住的话迟早有人误提交一份带着
# 本地端口与时间戳的日志。
*-gate.log
*-gate-err.log
mock-*.log

# 本地工具与编辑器的工作目录。
# .claude/ 下有 worktrees 等本地状态，与项目无关，也不该进公开仓库。
.claude/
.idea/
.vscode/
.vs/
